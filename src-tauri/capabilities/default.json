{
  "identifier": "default",
  "description": "Capabilities for the main WordBuddy window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    "global-shortcut:default",
    "sql:default",
    "process:default",
    "log:default",
    "core:event:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-start-dragging"
  ]
}
