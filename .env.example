# WorkBuddy Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is in .gitignore.

# Required: Anthropic API key for Claude
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Optional: ElevenLabs API key for text-to-speech voice responses
# Get one at https://elevenlabs.io/
ELEVENLABS_API_KEY=xi-your-key-here

# Optional: ElevenLabs voice ID (default: Rachel - 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Note: WorkBuddy stores keys in the OS config directory, not in .env files.
# This file exists as a reference for what credentials are needed.
